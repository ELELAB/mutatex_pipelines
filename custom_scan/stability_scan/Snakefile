import pandas as pd
import numpy as np
import glob
import os
import logging
import mutatex
import shutil
from Bio import PDB

configfile: 'config.yaml'
models = pd.read_csv(config['models'], keep_default_na=False)

assert all(list(map(os.path.isfile,config["csv_dir"]+"/"+models["protein_name"]+models["chain"]+".csv"))), "Each pdb must have a CSV mutations table associated. Its file name must contain the following wildcards: protein_name and chain (e.g., lc3ba.csv)."

pdb_list=list(config["pdb_dir"]+"/"+models["pdb_file"])
parser = PDB.PDBParser()
for pdb in pdb_list:
    structure = parser.get_structure(pdb, pdb)
    assert len(list(structure[0].get_chains())) == 1, "The pdbs must be single chain."

rule all:
    input:
        expand("%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name}/{restraints}/{scan}/summary.txt" %config["out_dir"],
                    zip,
                    protein_name=models["protein_name"],
                    PDB=models["PDB"],
                    chain=models["chain"],
                    aa_protein=models["aa_protein"],
                    method=models["method"],
                    model_name=models["model_name"],
                    scan=models["scan"],
                    restraints=models["restraints"])

rule input_files:
    input:
        pdb=lambda wcs: config["pdb_dir"]+"/"+models.set_index(["protein_name","method","PDB","chain","aa_protein","restraints","model_name","scan"]).loc[(wcs.protein_name,wcs.method,wcs.PDB,wcs.chain,wcs.aa_protein,wcs.restraints,wcs.model_name,wcs.scan), "pdb_file"],
        csv=lambda wcs: config["csv_dir"]+"/"+wcs.protein_name+wcs.chain+".csv"
    output:
        link_pdb="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/{protein_name}_{PDB}.pdb" %config["out_dir"],
        mutate="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/mutate_runfile_template.txt" %config["out_dir"],
        interface="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/interface_runfile_template.txt" %config["out_dir"],
        repair="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/repair_runfile_template.txt" %config["out_dir"],
        mutation_list="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/mutation_list.txt" %config["out_dir"],
        poslist="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/poslist.txt" %config["out_dir"],
        readme="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/README_mutatex_run" %config["out_dir"],
        mutation_summary="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/mutation_summary.txt" %config["out_dir"]
    params:
        workflow_dir=os.path.abspath(os.path.dirname(workflow.snakefile))
    run:
        out_dir=f"""{config["out_dir"]}/{wildcards.method}_{wildcards.protein_name}_{wildcards.PDB}{wildcards.chain}_{wildcards.aa_protein}/{wildcards.model_name}/{wildcards.restraints}/{wildcards.scan}"""
        shutil.copy2(input.pdb, out_dir)
        os.symlink(os.path.abspath(glob.glob(out_dir+"/*.pdb")[0]), output.link_pdb)
        with open(output.mutate,'w') as mutate:
            mutate.write(config["mutate_runfile"])
        with open(output.interface,'w') as interface:
            interface.write(config["interface_runfile"])
        with open(output.repair,'w') as repair:
            repair.write(config["repair_runfile"])
        csv=pd.read_csv(input.csv)
        if pd.Series(["WT residue", "Position", "Mutated residue"]).isin(csv.columns).all() == True: 
            my_col=csv[["WT residue", "Position", "Mutated residue"]].set_index("Position").loc[int(wildcards.aa_protein.rpartition("-")[0]):int(wildcards.aa_protein.rpartition("-")[2])].dropna().reset_index().apply(lambda x: '%s%s%s' % (x["WT residue"], int(x["Position"]), x["Mutated residue"]),axis=1)
        else:
            my_col=csv[csv["Mutation"].str.contains('|'.join(str(i) for i in range(int(wildcards.aa_protein.rpartition("-")[0]),int(wildcards.aa_protein.rpartition("-")[2])+1)),na=False)]["Mutation"].str.replace("p","")
        mutlist=my_col.apply(lambda x: "%s" % (x[-1:])).drop_duplicates().to_csv(output.mutation_list, index=False, header=False)
        poslist=my_col.apply(lambda x: "%s%s%s" % (x[0],wildcards.chain.upper(),x[1:-1])).drop_duplicates().to_csv(output.poslist, index=False, header=False)
        mutation_summary=my_col.apply(lambda x: "%s%s%s%s" % (x[0],wildcards.chain.upper(),x[1:-1],x[-1:])).to_csv(output.mutation_summary, index=False, header=False)
        
        read_content=f"""# This directory contains a custom scanning run performed with mutatex. This directory was generated by the following Snakemake pipeline:

# {params.workflow_dir}

# The input PDB file has been copied from:

# {input.pdb}

# In order to run it, the following steps are required:
# source virtual environment
. /usr/local/envs/mutatex/bin/activate

# A symbolic link is also required to avoid problems with files having multiple dots in the filename
ln -s {input.pdb} {output.link_pdb}

"""
        with open(output.readme, "w") as readme:
            readme.write(read_content)
 
rule mutatex_scan:
    input:
        link_pdb="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/{protein_name}_{PDB}.pdb" %config["out_dir"],
        mutate="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/mutate_runfile_template.txt" %config["out_dir"],
        interface="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/interface_runfile_template.txt" %config["out_dir"],
        repair="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/repair_runfile_template.txt" %config["out_dir"],
        mutation_list="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/mutation_list.txt" %config["out_dir"],
        poslist="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/poslist.txt" %config["out_dir"],
        readme="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/README_mutatex_run" %config["out_dir"]
    output:
        directory("%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/results/mutation_ddgs/{protein_name}_{PDB}_model0_checked_Repair" %config["out_dir"]),
        "%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/mutations.tar.gz" %config["out_dir"]
    params:
        foldx_exe=config["mutatex"]["foldx_exe"],
        skip_repair="-S" if config["mutatex"]["skip_repair"] == True else "",
    threads:
        1
    shell:
        """
        set +u; source /usr/local/envs/mutatex/bin/activate; set -u
        cd {config[out_dir]}/{wildcards.method}_{wildcards.protein_name}_{wildcards.PDB}{wildcards.chain}_{wildcards.aa_protein}/{wildcards.model_name}/{wildcards.restraints}/{wildcards.scan}/
        echo -e "# mutatex command\nmutatex $(basename {input.link_pdb}) -q $(basename {input.poslist}) {params.skip_repair} -m $(basename {input.mutation_list}) --foldx-version=suite5 --np {threads} -x {params.foldx_exe} -C deep -v -L -c -l >& log &" >> $(basename {input.readme})
        mutatex $(basename {input.link_pdb}) -q $(basename {input.poslist}) {params.skip_repair} -m $(basename {input.mutation_list}) --foldx-version=suite5 --np {threads} -x {params.foldx_exe} -C deep -v -L -c -l >& log
        """

rule mut_summary:
    input:
        mutation_tar="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/mutations.tar.gz" %config["out_dir"], 
        repair="%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/results/mutation_ddgs/{protein_name}_{PDB}_model0_checked_Repair" %config["out_dir"]
    output:
        "%s/{method}_{protein_name}_{PDB}{chain}_{aa_protein}/{model_name,.*}/{restraints,.*}/{scan,.*}/summary.txt" %config["out_dir"]
    shell:
        """
        set +u; source /usr/local/envs/mutatex/bin/activate; set -u
        cd {config[out_dir]}/{wildcards.method}_{wildcards.protein_name}_{wildcards.PDB}{wildcards.chain}_{wildcards.aa_protein}/{wildcards.model_name}/{wildcards.restraints}/{wildcards.scan}/
        echo -e "\n# summary.txt file command\nddg2summary -p {wildcards.protein_name}_{wildcards.PDB}_model0_checked.pdb -d results/mutation_ddgs/{wildcards.protein_name}_{wildcards.PDB}_model0_checked_Repair -l mutation_list.txt -L mutation_summary.txt" >> README_mutatex_run
        ddg2summary -p {wildcards.protein_name}_{wildcards.PDB}_model0_checked.pdb -d results/mutation_ddgs/$(basename {input.repair}) -l mutation_list.txt -L mutation_summary.txt
        """
