import pandas as pd
import os

configfile: "config.yaml"
models = pd.read_csv(config["models"], keep_default_na=False)

rule all:
    input:
        expand("{gene}/free/stability/mutatex_runs/{database}_{start_res}-{end_res}/model_{version}/saturation/{prot_id}_table/energies.csv",
                    zip,
                    gene=models["coding_gene"],
                    database=models["database"],
                    start_res=models["start_res"],
                    end_res=models["end_res"],
                    version=models["version"],
                    prot_id=models["prot_id"]
                    )

rule input_txt:
    input:

    output:
        mutate="{gene}/free/stability/mutatex_input_preparation/{database}_{start_res}-{end_res}/model_{version}/saturation/mutate_runfile.txt",
        repair="{gene}/free/stability/mutatex_input_preparation/{database}_{start_res}-{end_res}/model_{version}/saturation/repair_runfile.txt",
        mutation_list="{gene}/free/stability/mutatex_input_preparation/{database}_{start_res}-{end_res}/model_{version}/saturation/mutation_list.txt",
        readme="{gene}/free/stability/mutatex_runs/{database}_{start_res}-{end_res}/model_{version}/saturation/README.txt"
    params:
        workflow_dir=os.path.abspath(os.path.dirname(workflow.snakefile))
    run:
        with open(output.mutate,'w') as mutate:
            mutate.write(config["mutate_runfile"])
        with open(output.repair,'w') as repair:
            repair.write(config["repair_runfile"])
        with open(output.mutation_list,'w') as mutation:
            mutation.write(config["mutation_list"])

        readme_content=f"""The current filetree was generated by running the following Snakemake pipeline:
                        
{params.workflow_dir}
                        
The scan folder hosts a custom scanning run performed with MutateX and the table folder
collects in a .csv file the predicted changes in folding free energy upon mutation for each protein residue.
                        
The following files were provided as input to perform the scan with MutateX:
- {output.mutate}
- {output.repair}
- {output.mutation_list}
The input .pdb file can be found in the folder:
{wildcards.gene}/free/stability/mutatex_input_preparation/{wildcards.database}_{wildcards.start_res}-{wildcards.end_res}/model_{wildcards.version}/saturation
                        
The pipeline can be summarized as follows:
1. Generate input files and create a consistent input directory structure
2. Copy, if provided by the user, or download from AF Protein Structure Database, the .pdb file 
from {wildcards.gene}/structure_selection into {wildcards.gene}/free/stability/mutatex_input_preparation/{wildcards.database}_{wildcards.start_res}-{wildcards.end_res}/model_{wildcards.version}/saturation
3. Trim the .pdb file by using pdb_selres tool to consider only the user-specified residues
4. Run MutateX and generate a consistent output directory structure
5. Collect resulting energies in a .csv file 
"""
	with open(output.readme, "w") as readme:
    	    readme.write(readme_content)
        

rule input_pdb:
    input:
        mutate="{gene}/free/stability/mutatex_input_preparation/{database}_{start_res}-{end_res}/model_{version}/saturation/mutate_runfile.txt",
        repair="{gene}/free/stability/mutatex_input_preparation/{database}_{start_res}-{end_res}/model_{version}/saturation/repair_runfile.txt",
        mutation_list="{gene}/free/stability/mutatex_input_preparation/{database}_{start_res}-{end_res}/model_{version}/saturation/mutation_list.txt",
        readme="{gene}/free/stability/mutatex_runs/{database}_{start_res}-{end_res}/model_{version}/saturation/README.txt"
    output:
        pdb_out="{gene}/free/stability/mutatex_input_preparation/{database}_{start_res}-{end_res}/model_{version}/saturation/{prot_id}_trimmed.pdb"
    params:
        env=config["pdb_selres_env"]
    shell:
        """
        if [ {wildcards.database} == "AF" ]; then
            mkdir -p {wildcards.gene}/structure_selection/AF
            cd {wildcards.gene}/structure_selection/AF
            wget https://alphafold.ebi.ac.uk/files/AF-{wildcards.prot_id}-F1-model_{wildcards.version}.pdb
            mv AF-{wildcards.prot_id}-F1-model_{wildcards.version}.pdb {wildcards.prot_id}.pdb
            cd ../../..
        fi
        input_dir={wildcards.gene}/free/stability/mutatex_input_preparation/{wildcards.database}_{wildcards.start_res}-{wildcards.end_res}/model_{wildcards.version}/saturation
        mkdir -p $input_dir
        cd $input_dir

        cp ../../../../../../structure_selection/{wildcards.database}/{wildcards.prot_id}.pdb .

        {params.env}
        pdb_selres -{wildcards.start_res}:{wildcards.end_res} {wildcards.prot_id}.pdb > {wildcards.prot_id}_trimmed.pdb
        
        """

rule mutatex_scan:
    input:
        "{gene}/free/stability/mutatex_input_preparation/{database}_{start_res}-{end_res}/model_{version}/saturation/{prot_id}_trimmed.pdb"
    output:
        directory("{gene}/free/stability/mutatex_runs/{database}_{start_res}-{end_res}/model_{version}/saturation/{prot_id}_scan")
    params:
        env=config["mutatex"]["env"],
        foldx_exe=config["mutatex"]["foldx_exe"],
        foldx_suite=config["mutatex"]["foldx_suite"]
    shell:
        """
        working_dir={wildcards.gene}/free/stability/mutatex_runs/{wildcards.database}_{wildcards.start_res}-{wildcards.end_res}/model_{wildcards.version}/saturation/{wildcards.prot_id}_scan
        mkdir -p $working_dir
        cd $working_dir

        {params.env}
    
        mutatex ../../../../../mutatex_input_preparation/{wildcards.database}_{wildcards.start_res}-{wildcards.end_res}/model_{wildcards.version}/saturation/{wildcards.prot_id}_trimmed.pdb \
            -p 4 \
            -m  ../../../../../mutatex_input_preparation/{wildcards.database}_{wildcards.start_res}-{wildcards.end_res}/model_{wildcards.version}/saturation/mutation_list.txt \
            -x {params.foldx_exe} \
            -f {params.foldx_suite} \
            -R ../../../../../mutatex_input_preparation/{wildcards.database}_{wildcards.start_res}-{wildcards.end_res}/model_{wildcards.version}/saturation/repair_runfile.txt \
            -M ../../../../../mutatex_input_preparation/{wildcards.database}_{wildcards.start_res}-{wildcards.end_res}/model_{wildcards.version}/saturation/mutate_runfile.txt \
            -C partial \
            -l \
            -L \
            -c \
            -v

        """

rule write_table:
    input:
        "{gene}/free/stability/mutatex_runs/{database}_{start_res}-{end_res}/model_{version}/saturation/{prot_id}_scan"
    output:
        "{gene}/free/stability/mutatex_runs/{database}_{start_res}-{end_res}/model_{version}/saturation/{prot_id}_table/energies.csv"
    shell:
        """
        working_dir={wildcards.gene}/free/stability/mutatex_runs/{wildcards.database}_{wildcards.start_res}-{wildcards.end_res}/model_{wildcards.version}/saturation/{wildcards.prot_id}_table
        mkdir -p $working_dir
        cd $working_dir

        {config[mutatex][env]}
        ddg2excel -p ../{wildcards.prot_id}_scan/{wildcards.prot_id}_trimmed_model0_checked.pdb\
                  -l ../../../../../mutatex_input_preparation/{wildcards.database}_{wildcards.start_res}-{wildcards.end_res}/model_{wildcards.version}/saturation/mutation_list.txt \
                  -d ../{wildcards.prot_id}_scan/results/mutation_ddgs/final_averages\
                  -F csv
        """
