rule write_table:
    input:
        "{gene}/stability/mutatex_analyses/{database}_{range}/model_{version}/saturation/{prot_model}_trimmed_model0_checked.pdb"
    output:
        directory("{gene}/stability/mutatex_analyses/{database}_{range}/model_{version}/saturation/{prot_model}_table")
    shell:
        """
        working_dir={wildcards.gene}/stability/mutatex_analyses/{wildcards.database}_{wildcards.range}/model_{wildcards.version}/saturation/{wildcards.prot_model}_table
        mkdir -p $working_dir
	    cd $working_dir
		
        {config[mutatex][env]}
        ddg2excel -p ../{wildcards.prot_model}_trimmed_model0_checked.pdb\
                    -l ../mutation_list.txt\
                    -d ../final_averages
        
	    ddg2excel -p ../{wildcards.prot_model}_trimmed_model0_checked.pdb\
                    -l ../mutation_list.txt\
                    -d ../final_averages\
		            -F csv
        """


