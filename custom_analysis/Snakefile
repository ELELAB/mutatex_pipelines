import pandas as pd 

configfile: "config.yaml"

models = pd.read_csv(config['models'], keep_default_na=False)

rule all:
    input:
        expand("{gene}/{status}/stability/mutatex_analyses/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_heatmap_truncated", zip, gene=models['coding_gene'], status=models['status'], method=models['method'], start_res=models['start_res'], end_res=models['end_res'], model=models['model'], pdb_filename=models['pdb_filename']),
        expand("{gene}/{status}/stability/mutatex_analyses/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_heatmap", zip, gene=models['coding_gene'], status=models['status'], method=models['method'], start_res=models['start_res'], end_res=models['end_res'], model=models['model'], pdb_filename=models['pdb_filename']),
        expand("{gene}/{status}/stability/mutatex_analyses/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_boxplot", zip, gene=models['coding_gene'], status=models['status'], method=models['method'], start_res=models['start_res'], end_res=models['end_res'], model=models['model'], pdb_filename=models['pdb_filename']),
        expand("{gene}/{status}/stability/mutatex_analyses/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_violinplot", zip, gene=models['coding_gene'], status=models['status'], method=models['method'], start_res=models['start_res'], end_res=models['end_res'], model=models['model'], pdb_filename=models['pdb_filename']),
        expand("{gene}/{status}/stability/mutatex_analyses/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_averageplot", zip, gene=models['coding_gene'], status=models['status'], method=models['method'], start_res=models['start_res'], end_res=models['end_res'], model=models['model'], pdb_filename=models['pdb_filename']),
        expand("{gene}/{status}/stability/mutatex_analyses/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_scatterplot", zip, gene=models['coding_gene'], status=models['status'], method=models['method'], start_res=models['start_res'], end_res=models['end_res'], model=models['model'], pdb_filename=models['pdb_filename']),
        expand("{gene}/{status}/stability/mutatex_analyses/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_logoplot", zip, gene=models['coding_gene'], status=models['status'], method=models['method'], start_res=models['start_res'], end_res=models['end_res'], model=models['model'], pdb_filename=models['pdb_filename']),
