    output:
        directory("{gene}/stability/mutatex_analyses/{database}_{range}/model_{version}/saturation/{prot_model}_logoplot")
    shell:
        """
        working_dir={wildcards.gene}/stability/mutatex_analyses/{wildcards.database}_{wildcards.range}/model_{wildcards.version}/saturation/{wildcards.prot_model}_logoplot
        mkdir -p $working_dir
