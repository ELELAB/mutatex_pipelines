rule write_table:
    input:
        "{gene}/{status}/stability/mutatex_analyses/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_model0_checked.pdb"
    output:
        directory("{gene}/{status}/stability/mutatex_analyses/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_table")
    shell:
        """
        working_dir={wildcards.gene}/{wildcards.status}/stability/mutatex_analyses/{wildcards.method}_{wildcards.start_res}-{wildcards.end_res}/{wildcards.model}/saturation/{wildcards.pdb_filename}_table
        mkdir -p $working_dir
	    cd $working_dir
		
        {config[mutatex][env]}
        ddg2excel -p ../{wildcards.pdb_filename}_model0_checked.pdb\
                    -l ../mutation_list.txt\
                    -d ../final_averages
        
	    ddg2excel -p ../{wildcards.pdb_filename}_model0_checked.pdb\
                    -l ../mutation_list.txt\
                    -d ../final_averages\
		            -F csv
        """


