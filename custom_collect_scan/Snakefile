rule aggregate_tables:
    input:
        energies=domain_energy_files
    output:
        energies="{gene}/free/stability/mutatex_runs/aggregate/model_{version}/saturation/{prot_id}_table/energies.csv",
        energies_std="{gene}/free/stability/mutatex_runs/aggregate/model_{version}/saturation/{prot_id}_table/energies_std.csv"
    run:
        outdir = Path(output.energies).parent
        outdir.mkdir(parents=True, exist_ok=True)

        energy_tables = []
        std_tables = []

        for energy_file in input.energies:
            energy_path = Path(energy_file)
            std_path = energy_path.parent / "energies_std.csv"

            if not std_path.exists():
                raise WorkflowError(
                    f"Expected standard-deviation table was not found: {std_path}\n"
                    f"This file should be created by ddg2excel with the -s option."
                )

            energy_tables.append(pd.read_csv(energy_path))
            std_tables.append(pd.read_csv(std_path))

        pd.concat(energy_tables, ignore_index=True).to_csv(output.energies, index=False)
        pd.concat(std_tables, ignore_index=True).to_csv(output.energies_std, index=False)
