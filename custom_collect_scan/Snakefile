import pandas as pd
import os

configfile: "config.yaml"
models = pd.read_csv(config["models"], keep_default_na=False)

rule all:
    input:
        expand("{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_energies.csv",
                    zip,
                    gene=models["coding_gene"],
                    status=models["status"],
                    method=models["method"],
                    start_res=models["start_res"],
                    end_res=models["end_res"],
                    model=models["model"],
                    pdb_filename=models["pdb_filename"]
                    )

rule input_txt:
    input:

    output:
        mutate="{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/mutate_runfile.txt",
        repair="{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/repair_runfile.txt",
        mutation_list="{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/mutation_list.txt",
        readme="{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/README.txt"
    params:
        workflow_dir=os.path.abspath(os.path.dirname(workflow.snakefile)),
    run:
        with open(output.mutate,'w') as mutate:
            mutate.write(config["mutate_runfile"])
        with open(output.repair,'w') as repair:
            repair.write(config["repair_runfile"])
        with open(output.mutation_list,'w') as mutation:
            mutation.write(config["mutation_list"])

        readme_content=f"""The current filetree was generated by running the following Snakemake pipeline:
                        
{params.workflow_dir}
                        
The scan folder hosts a custom scanning run performed with MutateX and the table folder
collects in a .csv file the predicted changes in folding free energy upon mutation for each protein residue.
                        
The following files were provided as input to perform the scan with MutateX:
- {output.mutate}
- {output.repair}
- {output.mutation_list}
The input .pdb file can be found in the folder:
{wildcards.gene}/{wildcards.status}/structure_selection/{wildcards.method}
                        
The pipeline can be summarized as follows:
1. Generate input .txt files and create a consistent input directory structure
2. Copy, if provided by the user, or download from AF Protein Structure method, the input .pdb file 
from {wildcards.gene}/structure_selection into {wildcards.gene}/{wildcards.status}/stability/mutatex_runs/{wildcards.method}_{wildcards.start_res}-{wildcards.end_res}/{wildcards.model}/saturation
3. Trim the .pdb file by using pdb_selres tool to consider only the user-specified residues if required by the user 
4. Run MutateX and generate a consistent output directory structure
5. Collect resulting energies in a .csv file 
"""
	with open(output.readme, "w") as readme:
    	    readme.write(readme_content)
        

rule input_pdb:
    input:
        mutate="{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/mutate_runfile.txt",
        repair="{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/repair_runfile.txt",
        mutation_list="{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/mutation_list.txt",
        readme="{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/README.txt"
    output:
        pdb_out="{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}.pdb"
    wildcard_constraints:
        pdb_filename="([a-zA-Z0-9]+_[a-zA-Z0-9]+|[a-zA-Z0-9]+)"
    params:
        env=config["pdb_selres_env"],
        prot_id=lambda wildcards: models.loc[models["pdb_filename"] == wildcards.pdb_filename].prot_id.item(),
        trimmed=lambda wildcards: models.loc[models["pdb_filename"] == wildcards.pdb_filename].trimmed.item()
    shell:
        """
        if [ {wildcards.method} == "AF" ]; then
            mkdir -p {wildcards.gene}/structure_selection/AF
            cd {wildcards.gene}/structure_selection/AF
            wget https://alphafold.ebi.ac.uk/files/AF-{params.prot_id}-F1-{wildcards.model}.pdb
            mv AF-{params.prot_id}-F1-{wildcards.model}.pdb {wildcards.pdb_filename}.pdb
            cd ../../..
        fi

        input_dir={wildcards.gene}/{wildcards.status}/stability/mutatex_runs/{wildcards.method}_{wildcards.start_res}-{wildcards.end_res}/{wildcards.model}/saturation
        mkdir -p $input_dir
        cd $input_dir

        cp ../../../../../../structure_selection/{wildcards.method}/{wildcards.pdb_filename}.pdb .

        if [ {params.trimmed} == "NO" ]; then
            {params.env}
            pdb_selres -{wildcards.start_res}:{wildcards.end_res} {wildcards.pdb_filename}.pdb > {wildcards.pdb_filename}_selected.pdb
            mv {wildcards.pdb_filename}_selected.pdb {wildcards.pdb_filename}.pdb 
        fi

        """

rule mutatex_scan:
    input:
        "{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}.pdb"
    output:
        "{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_model0_checked.pdb"
    params:
        mutatex_env=config["mutatex"]["env"],
        foldx_exe=config["mutatex"]["foldx_exe"],
        foldx_suite=config["mutatex"]["foldx_suite"]
    shell:
        """
        working_dir={wildcards.gene}/{wildcards.status}/stability/mutatex_runs/{wildcards.method}_{wildcards.start_res}-{wildcards.end_res}/{wildcards.model}/saturation
        mkdir -p $working_dir
        cd $working_dir

        {params.mutatex_env}
        mutatex {wildcards.pdb_filename}.pdb \
            -p 4 \
            -m  mutation_list.txt \
            -x {params.foldx_exe} \
            -f {params.foldx_suite} \
            -R repair_runfile.txt \
            -M mutate_runfile.txt \
            -C partial \
            -l \
            -L \
            -c \
            -v

        """

rule write_table:
    input:
        "{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_model0_checked.pdb"
    output:
        "{gene}/{status}/stability/mutatex_runs/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_energies.csv"
    params:
        mutatex_env=config["mutatex"]["env"],
    shell:
        """
        working_dir={wildcards.gene}/{wildcards.status}/stability/mutatex_runs/{wildcards.method}_{wildcards.start_res}-{wildcards.end_res}/{wildcards.model}/saturation
        mkdir -p $working_dir
        cd $working_dir

        {params.mutatex_env}
        ddg2excel -p {wildcards.pdb_filename}_model0_checked.pdb\
                  -l mutation_list.txt \
                  -d results/mutation_ddgs/final_averages\
                  -F csv

        mv energies.csv {wildcards.pdb_filename}_energies.csv

        """
        
