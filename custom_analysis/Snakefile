rule plot_logo:
    input:
        "{gene}/{status}/stability/mutatex_analyses/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_model0_checked.pdb"
    params:
        font_size=config['plot_params']['font_size'],
        n_res=config['plot_params']['n_res_plot'],
        threshold=config['plot_params']['logo_plot']['destabilizing_threshold']
    output:
        directory("{gene}/{status}/stability/mutatex_analyses/{method}_{start_res}-{end_res}/{model}/saturation/{pdb_filename}_logoplot")
    shell:
        """
        working_dir={wildcards.gene}/{wildcards.status}/stability/mutatex_analyses/{wildcards.method}_{wildcards.start_res}-{wildcards.end_res}/{wildcards.model}/saturation/{wildcards.pdb_filename}_logoplot
        mkdir -p $working_dir
	    cd $working_dir
		
        {config[mutatex][env]}
        ddg2logo -p ../{wildcards.pdb_filename}_model0_checked.pdb\
                    -l ../mutation_list.txt\
                    -d ../final_averages\
                    -s {params.n_res}\
		            -f {params.font_size}\
                    -t {params.threshold}\
		            -x 10
        """
    
